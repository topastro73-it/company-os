# CompanyOS — variabili d'ambiente (copia in .env, MAI committare .env).
# Solo nomi di variabili: i valori li imposti localmente. Vedi config/integrations.example.yaml.

# Google Drive — path della chiave JSON del service account (osctl)
GDRIVE_SA_KEY_PATH=

# ClickUp — execution prodotto
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=

# Fatturazione elettronica (es. Fatture in Cloud o tool locale)
BILLING_ACCESS_TOKEN=
BILLING_COMPANY_ID=

# Banca — saldi, movimenti (preferisci il keychain di sistema al .env)
BANK_LOGIN=
BANK_SECRET=

# ERP / DB dati live — finance/CRM/contratti/KPI
ERP_DB_URL=

# Anthropic — automazioni (job batch)
ANTHROPIC_API_KEY=

# Nota: Stripe, HubSpot, Gmail, Calendar usano connector OAuth — nessuna env qui.
